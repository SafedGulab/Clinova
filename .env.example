# Names only. Copy to .env locally; set real values in Vercel project settings for production.
DATABASE_URL=
# If your provider has no separate direct (non-pooled) URL, set DIRECT_URL to the same value as DATABASE_URL.
DIRECT_URL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
APP_URL=
# At least 32 random characters, e.g. output of: openssl rand -base64 48
SESSION_SECRET=
# Only needed for the protected admin bootstrap command (added in a later step)
ADMIN_SETUP_SECRET=
